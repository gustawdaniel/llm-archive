[Unit]
Description=Brain Audio Feed - Daily Podcast Generator
After=network-online.target tailscaled.service

[Service]
Type=oneshot
WorkingDirectory=%h/apps/llm-archive
ExecStart=%h/.local/bin/uv run python -m src.audio_feed.rss_server --generate-daily
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
